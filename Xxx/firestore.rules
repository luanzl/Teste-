rules_version = '2';
// =====================================================================
// 2LETTERS — FIRESTORE RULES V9
//
// ⚠️  PUBLIQUE ESTA VERSÃO SOMENTE DEPOIS de o app novo (v53) estar no ar
//     (GitHub Pages) e de você ter aberto o app e dado F5/recarregado.
//     A V9 recusa a leitura da auditoria para funcionários; o app antigo
//     (v52) lia a auditoria no login de todos — com a V9 + app antigo, o
//     login dos funcionários falha. O app v53 já não lê a auditoria
//     quando o usuário não é o administrador.
//     (A V8 funciona com o app antigo e com o novo. Se tiver dúvida,
//     publique a V8 primeiro, suba o app, e só então publique a V9.)
//
// O QUE A V9 TEM (acumulado desde a V7 publicada)
//
// 1) O campo "id" gravado DENTRO de cada documento tem que ser igual ao id
//    do próprio documento (perfis_usuarios e todas as coleções do
//    estabelecimento). Fecha, no servidor, a porta de quem gravava um "id"
//    com HTML para rodar código na tela do administrador.
//
// 2) Sem a regra genérica "match /{document=**}" em /perfis/{ownerId}.
//    No Firestore, basta UMA regra permitir para o acesso ser liberado;
//    a genérica anulava as travas do dono. Toda coleção que o app usa tem
//    regra própria; o que não tem regra é NEGADO (fechado por padrão).
//
// 3) Auditoria imutável (ninguém altera nem apaga, nem o dono) e o
//    actorUid gravado tem que ser o uid de quem está gravando.
//    >>> NOVO na V9: só o DONO (administrador) LÊ a auditoria. Funcionários
//    continuam podendo CRIAR eventos, mas não enxergam o histórico.
//
// 4) isAdmin é imutável depois que o perfil é criado.
//
// 5) Dados pessoais (CPF/CNPJ, endereço, contato, empresa) ficam em
//    perfis_usuarios/{uid}/private/perfil — só o próprio usuário lê e
//    grava. O app v53 migra sozinho, no primeiro login de cada usuário,
//    os dados que estavam no documento público.
//
// AINDA FICA PARA VOCÊ (só no Console do Firebase — não dá para fazer
// pelo código nem por regra): App Check, restringir a chave de API ao seu
// domínio, remover "localhost" dos domínios autorizados, alerta de
// orçamento, política de senha / MFA, exportação agendada / PITR.
//
// COMO PUBLICAR
//  1. Firebase Console → Firestore Database → Regras.
//  2. O console guarda o histórico de versões (dá para voltar atrás).
//  3. Cole este arquivo, teste no "Playground de regras" e publique.
//  4. Se algum funcionário ou o dono tomar "Sem permissão", volte para a
//     versão anterior pelo histórico e me avise.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/perfis_usuarios/$(uid));
    }

    function hasProfile(uid) {
      return signedIn() && exists(/databases/$(database)/documents/perfis_usuarios/$(uid));
    }

    function myData() {
      return userDoc(request.auth.uid).data;
    }

    // Perfil ativo (não inativado pelo administrador)
    function isActive(uid) {
      return hasProfile(uid)
        && userDoc(uid).data.get('ativo', true) != false
        && userDoc(uid).data.get('situacao', 'ativo') != 'inativo';
    }

    // Pertence ao estabelecimento (ownerId) e está ativo
    function belongsTo(ownerId) {
      return isActive(request.auth.uid)
        && myData().get('ownerId', '') == ownerId;
    }

    // É o administrador (dono) daquele estabelecimento
    function isOwner(ownerId) {
      return belongsTo(ownerId)
        && request.auth.uid == ownerId
        && myData().get('isAdmin', false) == true;
    }

    // Administrador, sem precisar saber o ownerId de antemão
    function isAdminSelf() {
      return hasProfile(request.auth.uid) && myData().get('isAdmin', false) == true;
    }

    // Permissão por área (agenda / clientes / financeiro / anamnese),
    // espelhando getPerfilPermissions()/canAccessArea() do app:
    // administrador sempre tem acesso; funcionário tem acesso a menos
    // que a área esteja explicitamente marcada como false.
    function perm(area) {
      return isAdminSelf()
        || myData().get('permissions', {}).get(area, true) == true;
    }

    // V8: o "id" gravado dentro do documento (se existir) tem que ser o
    // id do próprio documento. Só vale em create/update (request.resource).
    function idOk(docId) {
      return request.resource.data.get('id', docId) == docId;
    }

    // ---------- Perfis / funcionários ----------
    match /perfis_usuarios/{uid} {

      // Leitura: o próprio usuário, ou qualquer colega do mesmo
      // estabelecimento (necessário para listas de responsável,
      // seleção de funcionário na Visão do Dono etc.)
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (isActive(request.auth.uid) &&
         resource.data.get('ownerId', '') == myData().get('ownerId', ''))
      );

      // Criação do PRÓPRIO perfil como ADMINISTRADOR (primeiro
      // cadastro / criação de conta).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.get('ownerId', uid) == uid
        && request.resource.data.get('isAdmin', true) == true
        && idOk(uid);

      // Criação de um perfil de FUNCIONÁRIO — só o administrador
      // (dono) pode criar, e o novo perfil tem que apontar para ele
      // como ownerId e nunca nascer como admin.
      allow create: if signedIn()
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('isAdmin', true) == false
        && idOk(uid)
        && isOwner(request.auth.uid);

      // Atualização feita pelo ADMINISTRADOR (dono) sobre qualquer
      // perfil do seu estabelecimento — inclusive o próprio. O
      // ownerId e o isAdmin nunca podem ser trocados por essa via.
      allow update: if signedIn()
        && isOwner(resource.data.get('ownerId', ''))
        && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && idOk(uid);

      // Atualização do FUNCIONÁRIO no PRÓPRIO perfil (nome, e-mail,
      // avatar, contato etc.) — mas nunca em campos de privilégio:
      // isAdmin, ownerId, ativo, situacao e permissions continuam
      // exatamente como estavam.
      allow update: if signedIn()
        && request.auth.uid == uid
        && isActive(uid)
        && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('ativo', true) == resource.data.get('ativo', true)
        && request.resource.data.get('situacao', 'ativo') == resource.data.get('situacao', 'ativo')
        && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
        && idOk(uid);

      allow delete: if false; // perfis nunca são apagados, só inativados

      // Dados pessoais privados do próprio usuário (CPF/CNPJ, endereço,
      // contato, empresa). Nem o administrador nem os colegas leem.
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Dados operacionais do estabelecimento ----------
    match /perfis/{ownerId} {
      // cfg (nome do estúdio, moeda, tema, mensagens de WhatsApp...)
      allow read: if belongsTo(ownerId);
      allow create: if isOwner(ownerId); // só o administrador cria o esqueleto inicial
      allow update: if isOwner(ownerId);
      allow delete: if isOwner(ownerId);

      match /clientes/{id} {
        allow read, delete: if belongsTo(ownerId) && perm('clientes');
        allow create, update: if belongsTo(ownerId) && perm('clientes') && idOk(id);
      }
      match /agenda/{id} {
        allow read, delete: if belongsTo(ownerId) && perm('agenda');
        allow create, update: if belongsTo(ownerId) && perm('agenda') && idOk(id);
      }
      match /servicos/{id} {
        allow read, delete: if belongsTo(ownerId) && perm('agenda');
        allow create, update: if belongsTo(ownerId) && perm('agenda') && idOk(id);
      }
      match /tx/{id} {
        allow read, delete: if belongsTo(ownerId) && perm('financeiro');
        allow create, update: if belongsTo(ownerId) && perm('financeiro') && idOk(id);
      }
      match /fiados/{id} {
        allow read, delete: if belongsTo(ownerId) && perm('financeiro');
        allow create, update: if belongsTo(ownerId) && perm('financeiro') && idOk(id);
      }
      match /an/{id} {
        allow read, delete: if belongsTo(ownerId) && perm('anamnese');
        allow create, update: if belongsTo(ownerId) && perm('anamnese') && idOk(id);
      }

      // Auditoria IMUTÁVEL: só pode ser criada (por qualquer usuário ativo do
      // estabelecimento), nunca alterada nem apagada, e a autoria (actorUid)
      // tem que ser de quem está gravando. Leitura: só o administrador.
      match /audit/{id} {
        allow read: if isOwner(ownerId);   // V9: só o administrador lê
        allow create: if belongsTo(ownerId)
          && idOk(id)
          && request.resource.data.get('actorUid', '') == request.auth.uid;
        allow update, delete: if false;
      }

      // Coleções restritas ao administrador
      match /backups/{id} {
        allow read, write: if isOwner(ownerId);
      }
      match /usuarios/{id} {
        allow read, write: if isOwner(ownerId);
      }

      // Sem regra genérica: subcoleção nova precisa de regra explícita
      // (o que não tem regra é NEGADO para todos, inclusive o dono).
    }
  }
}
